{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "mocha", "webdriverio", "@wdio/globals"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "tests/**/*.ts",
    "pageobjects/**/*.ts",
    "helpers/**/*.ts",
    "fixtures/**/*.ts",
    "data/**/*.ts",
    "wdio.shared.conf.ts",
    "wdio.ios.conf.ts",
    "wdio.android.conf.ts"
  ],
  "exclude": ["node_modules", "dist", "allure-results", "screenshots"]
}