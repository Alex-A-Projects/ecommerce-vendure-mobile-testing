{
  "name": "vendure-mobile-web-testing",
  "version": "1.0.0",
  "description": "Mobile web automation framework for the Vendure Remix Storefront, built on TypeScript + WebdriverIO + Appium 2. Runs the storefront on iOS Safari (XCUITest, iPhone 17 simulator) and Android Chrome (UiAutomator2, Samsung Galaxy emulator) using a single Page Object Model.",
  "private": true,
  "type": "module",
  "scripts": {
    "test:ios": "wdio run wdio.ios.conf.ts",
    "test:android": "wdio run wdio.android.conf.ts",
    "test:both": "npm run test:ios && npm run test:android",
    "test:ios:headed": "WDIO_HEADED=1 wdio run wdio.ios.conf.ts",
    "test:android:headed": "WDIO_HEADED=1 wdio run wdio.android.conf.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "appium:doctor": "appium-doctor",
    "appium:install-ios": "appium driver install xcuitest",
    "appium:install-android": "appium driver install uiautomator2",
    "clean": "rm -rf allure-results allure-report screenshots .tsbuildinfo wdio-logs wdio-*.log"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@wdio/allure-reporter": "^9.31.0",
    "@wdio/appium-service": "^9.31.0",
    "@wdio/cli": "^9.31.0",
    "@wdio/globals": "^9.31.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.31.0",
    "@wdio/spec-reporter": "^9.31.0",
    "allure-commandline": "^2.46.1",
    "appium": "^2.11.0",
    "deepmerge": "^4.3.1",
    "expect-webdriverio": "^6.0.9",
    "typescript": "^5.6.0",
    "webdriverio": "^9.31.0"
  }
}